# Public Cal.com event URL, such as https://cal.com/username/consultation.
# Copy to .env.local, paste your event URL, and restart Vite.
VITE_CAL_BOOKING_URL=
VITE_CAL_INTRO_BOOKING_URL=

# URL prefix for deployment. Cloudflare and custom domains use /.
# GitHub Pages sets its repository prefix automatically in the workflow.
VITE_BASE_PATH=/
